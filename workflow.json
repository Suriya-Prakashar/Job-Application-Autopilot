    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"fit_score\": 85,\n  \"confidence\": 92,\n\n  \"fit_summary\": \"Short explanation of the candidate's overall suitability.\",\n\n  \"score_breakdown\": {\n    \"core_skills\": {\n      \"score\": 27,\n      \"max_score\": 30,\n      \"reason\": \"Strong match with most required skills.\",\n      \"matched\": [\n        {\n          \"requirement\": \"Python\",\n          \"status\": \"Matched\",\n          \"proof\": \"Python listed under Technical Skills.\"\n        }\n      ],\n      \"partial_matches\": [],\n      \"missing\": [\n        {\n          \"requirement\": \"Kubernetes\",\n          \"status\": \"Not Found\",\n          \"proof\": \"Not found in the provided CV.\"\n        }\n      ]\n    },\n\n    \"experience\": {\n      \"score\": 16,\n      \"max_score\": 20,\n      \"reason\": \"Relevant internship experience is present.\",\n      \"proof\": [\n        \"Machine Learning internship experience is explicitly listed in the CV.\"\n      ]\n    },\n\n    \"projects\": {\n      \"score\": 14,\n      \"max_score\": 15,\n      \"reason\": \"Projects demonstrate relevant practical skills.\",\n      \"proof\": [\n        \"Relevant technical projects are explicitly listed in the CV.\"\n      ]\n    },\n\n    \"education\": {\n      \"score\": 10,\n      \"max_score\": 10,\n      \"reason\": \"Education matches the job requirement.\",\n      \"proof\": [\n        \"Candidate degree is explicitly listed in the CV.\"\n      ]\n    },\n\n    \"responsibilities\": {\n      \"score\": 8,\n      \"max_score\": 10,\n      \"reason\": \"Most responsibilities are supported by CV evidence.\",\n      \"proof\": []\n    },\n\n    \"certifications\": {\n      \"score\": 2,\n      \"max_score\": 5,\n      \"reason\": \"Some relevant certification evidence is present.\",\n      \"proof\": []\n    },\n\n    \"tools\": {\n      \"score\": 4,\n      \"max_score\": 5,\n      \"reason\": \"Most required tools are present.\",\n      \"proof\": []\n    },\n\n    \"ats_keywords\": {\n      \"score\": 4,\n      \"max_score\": 5,\n      \"reason\": \"Most important terminology is supported by the CV.\",\n      \"proof\": []\n    }\n  },\n\n  \"matching_skills\": [\n    \"Python\",\n    \"FastAPI\"\n  ],\n\n  \"missing_skills\": [\n    \"Kubernetes\"\n  ],\n\n  \"evidence\": [\n    {\n      \"requirement\": \"Python\",\n      \"status\": \"Matched\",\n      \"proof\": \"Python is explicitly listed in the candidate's technical skills.\"\n    }\n  ],\n\n  \"reasoning\": \"Detailed explanation of how the final score was calculated using only CV evidence.\",\n\n  \"cover_letter\": \"Personalized professional cover letter.\"\n}"
      },
